{
  "name": "jq-pointer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "bench": "vitest run bench/perf-spike.bench.test.ts",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
